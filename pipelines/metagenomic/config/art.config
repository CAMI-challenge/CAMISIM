params {
    profile_read_length=150
    fragment_size_mean = 270
    fragment_size_sd = 27
    base_profile_name="${projectDir}/tools/art_illumina-2.3.6/profiles/ART_MBARC-26_HiSeq_R"

    // ---------------------------------------------------------------------------
    // Substitution error rate control.  ADDED for the coverage-matrix project.
    //
    // ART shifts every simulated quality score by -qs (mate 1) / -qs2 (mate 2).
    // Positive = higher quality = FEWER errors.  Calibrated against ART's own -ef
    // error-free output on the MBARC profile (scripts/sim_calibrate_camisim_qs.sh):
    //
    //     qs   combined substitution rate
    //      0   3.4719 %   <- native MBARC = CAMI II (measured 3.4687 % on the real BAMs)
    //      5   1.1060 %
    //     15   0.1118 %
    //
    // NOTE: -qs is parsed as an INTEGER. A fractional value is silently truncated
    // (5.4 and 5.5 both behave as 5), with no warning.
    quality_shift = 0
    quality_shift2 = 0

    // Minimum quality score, ART's -qL.  Set to "" to omit the flag.
    //
    // CAMISIM previously hard-coded `-qL 15`, which RAISES every quality below 15
    // up to 15 and so deletes the low-quality 3' tail that produces most of MBARC's
    // errors. Measured effect on the MBARC profile: 3.4719 % -> 0.3137 %, an 11x
    // reduction. With -qL 15 CAMISIM cannot reproduce its own CAMI II dataset.
    // Default is now to omit it.
    min_quality = ""

    // Indel rates (-ir/-ir2 insertion, -dr/-dr2 deletion). Empty = ART's defaults
    // (9e-5 / 1.1e-4), which docs/errcorr/SIMULATION.md 3 measures as 20-30x the
    // real Illumina rate. Set explicitly to control them.
    insertion_rate = ""
    insertion_rate2 = ""
    deletion_rate = ""
    deletion_rate2 = ""
}
